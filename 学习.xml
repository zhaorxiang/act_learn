<!--
╔══════════════════════════════════════════════════════════════════╗
║            MuJoCo XML 文件规范与语法 — 初学者注释版              ║
╚══════════════════════════════════════════════════════════════════╝

一、MuJoCo XML 文件的整体结构
─────────────────────────────
  一个标准的 MuJoCo XML 文件以 <mujoco> 为根元素，其子元素分为两大部分：

  1. 模型描述 (model) — 定义物理世界的构成
  2. 仿真配置 (option/size 等) — 定义求解器参数

  模型描述的常用顶级子元素：
  ┌─────────────────┬────────────────────────────────────────────┐
  │  元素             │  作用                                      │
  ├─────────────────┼────────────────────────────────────────────┤
  │  <include>       │  引入外部 XML 文件（模块化复用）            │
  │  <compiler>      │  编译器选项（坐标角度单位、默认惯性等）      │
  │  <option>        │  物理引擎选项（积分器、重力、时间步长等）    │
  │  <size>          │  内存预分配大小                             │
  │  <asset>         │  网格(mesh)、材质等资源                     │
  │  <default>       │  默认属性值（可被具体元素覆盖）              │
  │  <worldbody>     │  世界坐标系下的刚体树（核心！）              │
  │  <equality>      │  约束条件（焊接、铰链、距离约束等）          │
  │  <tendon>        │  肌腱/绳索约束                              │
  │  <actuator>      │  驱动器（电机、位置控制、力矩控制等）        │
  │  <sensor>        │  传感器（力、力矩、触觉、视觉等）            │
  │  <keyframe>      │  关键帧（预设状态，用于重置/调试）           │
  │  <contact>       │  接触对参数                                 │
  └─────────────────┴────────────────────────────────────────────┘

  本文件是一个双臂插拔（peg-in-hole）任务场景，使用了两个 VX300S 机械臂。
-->

<!-- ============================================================
     根元素：<mujoco>
     ─────────────────
     一切 MuJoCo 模型的根标签，所有的物理元素都必须包含在其中。
     属性（本文件无属性，但常用有）：
       model="模型名称"  — 给模型起名字
     ============================================================ -->
<mujoco>
    <!-- ***********************************************************
         顶级子元素 (1)：<include>
         ─────────────────────────
         用于将外部 XML 文件的内容嵌入到当前文件中。
         类似于 C 语言的 #include，方便模块化管理模型。

         语法：<include file="相对或绝对路径"/>

         比如你的机械臂模型很大，单独放在一个文件里，
         在这里 include 进来就行，不需要把几千行都塞在一起。
         *********************************************************** -->
    <include file="scene.xml"/>                    <!-- 场景设置文件（可能包含光照、相机、option等） -->
    <include file="vx300s_dependencies.xml"/>      <!-- 机械臂依赖文件（可能包含关节、几何体 mesh 引用等） -->

    <!-- <include file="000.xml"/> -->
    <!-- ***********************************************************
         顶级子元素 (2)：<equality>
         ─────────────────────────
         定义"约束"——强制某些物体之间的运动关系。
         约束会在动力学方程中添加额外的拉格朗日乘子项。

         本文件中使用的是 <weld>（焊接约束）：
         它把两个 body "焊死"在一起，两者之间不能有相对运动。
         *********************************************************** -->
    <equality>
        <!-- ── <weld> 焊接约束 ────────────────────────────────────
             body1 : 约束的第一个刚体名称
             body2 : 约束的第二个刚体名称
             solref: 求解器参考参数，格式 "timeconst dampratio"
                     timeconst — 时间常数（越小越刚硬，典型值 0.01~0.02）
                     dampratio — 阻尼比（1 为临界阻尼）
             solimp: 求解器阻抗参数，格式 "dmin dmax width"
                     dmin/dmax — 最小/最大阻尼
                     width — 阻抗过渡区宽度
             relpose: 相对位姿（可选），不写则默认为建模时两物体的相对位置

             这里的意思是：
             把"手柄控制点(mocap_left)"焊在"左机械臂的爪子(gripper_link)"上，
             这样当我们移动 mocap 手柄时，爪子就跟着动。
             ──────────────────────────────────────────────────────── -->
        <weld body1="mocap_left"  body2="vx300s_left/gripper_link"  solref="0.01 1" solimp=".25 .25 0.001" />
        <weld body1="mocap_right" body2="vx300s_right/gripper_link" solref="0.01 1" solimp=".25 .25 0.001" />
    </equality>


    <!-- ***********************************************************
         顶级子元素 (3)：<worldbody>
         ─────────────────────────
         这是 MuJoCo 模型的"核心骨架"——定义一个以世界为根的树状刚体结构。

         关键概念：
         1. 所有物理实体（刚体）都嵌套在 <worldbody> 内
         2. 树形结构：每个 <body> 可以包含子 <body>
            子 body 默认通过 <joint> 连接在父 body 上
         3. 世界坐标系：X 向前，Y 向左，Z 向上（右手系）
         *********************************************************** -->
    <worldbody>
        <!-- 引入两个机械臂的 body 定义 -->
        <include file="vx300s_left.xml" />
        <include file="vx300s_right.xml" />

        <!-- ════════════════════════════════════════════════════════
             <body> 刚体元素 — 详细语法
             ════════════════════════════════════════════════════════

             <body> 是 MuJoCo 中最核心的元素之一，表示一个物理刚体。

             常用属性：
             ┌───────────┬──────────────────────────────────────────────┐
             │ 属性        │  含义                                        │
             ├───────────┼──────────────────────────────────────────────┤
             │ name      │  刚体名称（全局唯一，被其他元素引用）           │
             │ pos       │  相对父体的初始位置 (x, y, z)，单位：米         │
             │ quat      │  相对父体的初始姿态（四元数 w x y z）           │
             │ mocap     │  "true" 表示这是一个动捕体（由用户控制位置）     │
             │ childclass│  子元素默认类的引用                            │
             └───────────┴──────────────────────────────────────────────┘

             <body> 的常见子元素：
             ┌────────────┬──────────────────────────────────────────────┐
             │ 子元素       │  作用                                        │
             ├────────────┼──────────────────────────────────────────────┤
             │ <joint>    │  关节（连接父体的运动约束）                     │
             │ <inertial> │  惯性属性（质量、转动惯量）                     │
             │ <geom>     │  几何体（碰撞/视觉形状）                       │
             │ <site>     │  站点（附着点，如传感器位置、眼在手位置等）      │
             │ <body>     │  子刚体（树形递归）                            │
             └────────────┴──────────────────────────────────────────────┘
            ═══════════════════════════════════════════════════════════ -->


        <!-- ============================================================
             mocap 动捕体（mocap body）
             ──────────────────────────
             这是 MuJoCo 中一个很特殊的 body 类型。
             当 mocap="true" 时：
             - 它的位置/姿态完全由用户通过代码控制，不受物理定律支配
             - 它相当于一个"手柄"——你可以用鼠标、VR手柄或代码来拖动它
             - 它不会有物理碰撞响应（只对别的物体施加力，别的不推它）

             应用场景：遥操作、人机交互、演示收集、策略训练
             ============================================================ -->
        <body mocap="true" name="mocap_left" pos="0.095 0.50 0.425">
            <!-- ── <site> 站点 ─────────────────────────────────────
                 site 是附着在 body 上的"标记点"，可以做很多事情：
                 - 作为视觉标记（如此处的坐标轴指示器）
                 - 作为传感器的安装位置（如相机、力传感器）
                 - 作为连接点（肌腱附着点、约束连接点）

                 语法：<site pos=".." size=".." type=".." name=".." rgba=".."/>

                 属性：
                 name : 站点名称（全局唯一）
                 pos  : 相对父 body 的位置 (x, y, z)
                 size : 站点尺寸（不同 type 含义不同，box 是半边长）
                 type : 站点形状 (box/ellipsoid/sphere/cylinder 等)
                 rgba : 颜色 (红 R, 绿 G, 蓝 B, 透明度 A)，范围 0~1

                 这里的三个 site 是互相垂直的薄板（box），
                 组合起来形成一个三轴坐标系指示器，方便可视化看到手柄的姿态。
                 比如：site1 沿 Z 轴长（前后短=0.003，上下长=0.03）
                      site2 沿 Y 轴长（前后短=0.003，左右长=0.03）
                      site3 沿 X 轴长（左右短=0.003，前后长=0.03）
                 ──────────────────────────────────────────────────────── -->
            <site pos="0 0 0" size="0.003 0.003 0.03"  type="box" name="mocap_left_site1"  rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.003 0.03 0.003"  type="box" name="mocap_left_site2"  rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.03 0.003 0.003"  type="box" name="mocap_left_site3"  rgba="1 0 0 1"/>
        </body>

        <body mocap="true" name="mocap_right" pos="-0.095 0.50 0.425">
            <site pos="0 0 0" size="0.003 0.003 0.03"  type="box" name="mocap_right_site1" rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.003 0.03 0.003"  type="box" name="mocap_right_site2" rgba="1 0 0 1"/>
            <site pos="0 0 0" size="0.03 0.003 0.003"  type="box" name="mocap_right_site3" rgba="1 0 0 1"/>
        </body>


        <!-- ============================================================
             Peg（销钉/插头）— 一个带自由关节的刚体
             ============================================================ -->
        <body name="peg" pos="0.2 0.5 0.05">
            <!-- ── <joint> 关节 ─────────────────────────────────────
                 关节定义了 body 相对于父体（或世界）的"允许运动方式"。
                 如果把 body 比作一扇门，joint 就是门的合页——
                 它决定了门能绕哪个轴旋转、旋转多大角度。

                 <joint> 的 type 常见取值：
                 ┌──────────────┬──────────────────────────────────────┐
                 │ type          │  自由度 / 效果                        │
                 ├──────────────┼──────────────────────────────────────┤
                 │ "free"       │  6 DOF — 可任意平移+旋转（太空漂浮）   │
                 │ "ball"       │  3 DOF — 球铰，绕一点自由旋转（无平移） │
                 │ "hinge"      │  1 DOF — 铰链，绕一个轴旋转（门轴）     │
                 │ "slide"      │  1 DOF — 滑动副，沿一个轴平移（抽屉）   │
                 │ "fixed"      │  0 DOF — 完全固定，不能动               │
                 └──────────────┴──────────────────────────────────────┘

                 常用属性：
                 name         : 关节名（actuator 和 sensor 通过此名引用）
                 type         : 关节类型（见上表）
                 pos          : 关节在父体坐标中的位置
                 axis         : 关节轴方向向量（对 hinge/slide 必需，对 free 无意义）
                 range        : 关节角度/位移范围 "min max"（对 hinge/slide）
                 stiffness    : 关节刚度（弹簧系数，让关节像有弹簧一样回正）
                 damping      : 关节阻尼（让运动越来越慢的阻力）
                 frictionloss : 关节摩擦力（库仑摩擦）
                 armature     : 等效电枢转动惯量（模拟电机转子的惯性）
                 limited      : 是否启用角度/位移限位（true/false）
                 ──────────────────────────────────────────────────────── -->
            <joint name="red_peg_joint" type="free" frictionloss="0.01" />

            <!-- ── <inertial> 惯性属性 ──────────────────────────────
                 每个物理 body 都需要惯性信息，MuJoCo 才能计算它的运动。

                 属性详解：
                 mass : 质量（单位 kg），这个好理解，越重越难推动
                 pos  : 质心相对于 body 原点的偏移，不写默认 (0,0,0)
                 diaginertia : 对角转动惯量 (Ixx, Iyy, Izz)，表示绕
                               三个主轴的"旋转惰性"，值越大越难转动

                 关于转动惯量：
                 - Ixx 是绕 X 轴的转动惯量，类似地 Iyy/Izz
                 - 对于均匀长方体 (边长 Lx, Ly, Lz)：
                   Ixx = mass/12 × (Ly² + Lz²)
                 - 比如这个 peg：mass=0.05，size="0.06 0.01 0.01"
                   全边长 = (0.12, 0.02, 0.02)
                   Ixx = 0.05/12 × (0.02²+0.02²) ≈ 0.0000033（很小）
                 - 但这里用的是 0.002，比计算值大很多，可能是故意增大
                   转动惯量来让物体旋转更"稳"，不容易乱转
                 ──────────────────────────────────────────────────────── -->
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.002 0.002 0.002" />

            <!-- ── <geom> 几何体 ────────────────────────────────────
                 geom 是实际参与物理仿真的"碰撞体"和"可视化体"。
                 一个 body 可以有多个 geom（它们之间默认不互相碰撞）。

                 type 常见取值 + size 格式：
                 ┌──────────────┬────────────────────────────────────┐
                 │ type          │  形状       size 格式                │
                 ├──────────────┼────────────────────────────────────┤
                 │ "sphere"     │  球体       [半径]                   │
                 │ "capsule"    │  胶囊体     [半径 半长]               │
                 │ "cylinder"   │  圆柱体     [半径 半长]               │
                 │ "box"        │  长方体     [半x 半y 半z]             │
                 │ "plane"      │  无限平面   [半x 半y 半z]（矩形地面）  │
                 │ "ellipsoid"  │  椭球体     [半x 半y 半z]             │
                 │ "mesh"       │  三角网格   meshfile="xxx.stl"       │
                 └──────────────┴────────────────────────────────────┘

                 重要物理属性详解：
                 ┌──────────────┬─────────────────────────────────────────────┐
                 │ 属性           │  含义                                       │
                 ├──────────────┼─────────────────────────────────────────────┤
                 │ condim       │  接触维度：                                   │
                 │              │   1 = 仅法向力（无摩擦，物体滑来滑去）         │
                 │              │   3 = +切向摩擦（最基本的摩擦力）              │
                 │              │   4 = +滚动摩擦（物体会滚得越来越慢）          │
                 │              │   6 = +扭转摩擦（绕接触法线转也有阻力）        │
                 │ solref       │  求解器刚度参数 "timeconst dampratio"         │
                 │              │  timeconst 越小 → 接触越"硬"（像金属碰石头）   │
                 │              │  timeconst 越大 → 接触越"软"（像碰海绵）       │
                 │ solimp       │  求解器阻尼参数 "dmin dmax width mid"          │
                 │              │  控制穿透后的回复速度和能量耗散               │
                 │ friction     │  摩擦系数 "滑动 扭转 滚动"                     │
                 │              │  [0] 滑动摩擦 → 越大越"粗糙"                   │
                 │              │  [1] 扭转摩擦                                 │
                 │              │  [2] 滚动摩擦                                 │
                 │ margin       │  接触边距，正值在 geom 表面加"软壳"层          │
                 │ gap          │  接触间隙，正值=物体之间有空隙才能接触          │
                 │ rgba         │  颜色 (R,G,B,A)，每个通道 0~1                  │
                 │ contype      │  碰撞类型（0=不碰撞, 1=碰撞）                   │
                 │ conaffinity  │  碰撞亲和性（0=不碰撞, 1=碰撞）                 │
                 └──────────────┴─────────────────────────────────────────────┘

                 注意：
                 - MuJoCo 只支持凸形状参与碰撞检测（box、sphere、cylinder
                   等都天然是凸的；mesh 需要指定凸包近似）
                 - 一个 body 的多个 geom 之间默认不碰撞
                 - 两个不同的 body 是否碰撞取决于 contype × conaffinity：
                   只有当 bodyA.geom.contype & bodyB.geom.conaffinity ≠ 0
                   且 bodyA.geom.conaffinity & bodyB.geom.contype ≠ 0 才碰撞
                 ──────────────────────────────────────────────────────── -->
            <geom
                condim="4"                         <!-- 接触维度 4 = 法向力 + 切向摩擦 + 滚动摩擦 -->
                solimp="2 1 0.01"                  <!-- 接触阻抗参数：较大阻尼值，模拟较软的碰撞 -->
                solref="0.01 1"                    <!-- 接触刚度：时间常数 0.01 秒，临界阻尼比 1 -->
                friction="1 0.005 0.0001"         <!-- 滑动摩擦 1.0，扭转摩擦 0.005，滚动摩擦 0.0001 -->
                pos="0 0 0"                        <!-- 几何体在 body 局部坐标中的位置 -->
                size="0.06 0.01 0.01"              <!-- box 半边长：(长6cm, 宽1cm, 高1cm)，全长为12×2×2cm -->
                type="box"                         <!-- 形状类型 = 长方体 -->
                name="red_peg"                    <!-- geom 名称（全局唯一） -->
                rgba="1 0 0 1"                    <!-- 红色 (R=1, G=0, B=0, A=1不透明) -->
            />
        </body>


        <!-- ============================================================
             Socket（插座）— 由多个 box geom 拼成"凹槽"形状
             ─────────────────────────────────────────────
             这是一个非常重要的概念：在 MuJoCo 中，复杂形状可以通过
             多个简单几何体（box/cylinder/sphere）的组合来实现。

             这个 socket 的结构（从侧面看，X 为长轴方向）：
                            socket-2 (顶板)
                          ┌──────────────┐
               socket-3   │    pin(红)    │   socket-4 (左右侧壁)
                          └──────────────┘
                            socket-1 (底板)

             在 3D 中，4 块薄板围成一个方框，中间的 pin 是目标插入物。

             注意第35行的 XML 注释：<!-- ... -->
             这是注释掉的旧 geom，不参与仿真。
             ============================================================ -->
        <body name="socket" pos="-0.2 0.5 0.05">
            <!-- 同样是 free joint，socket 也可以在空间中自由运动 -->
            <joint name="blue_socket_joint" type="free" frictionloss="0.01" />
            <!-- 和 peg 完全一样的惯性参数 -->
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.002 0.002 0.002" />

            <!-- ↓ 被注释掉的 geom，不参与仿真。可能是之前调试时留下的参考 -->
<!--            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.005 0.0001" pos="0 0 0" size="0.06 0.01 0.01" type="box" name="red_peg_ref" rgba="1 0 0 1" />-->

            <!-- socket-1: 底部薄板，pos z=-0.02 表示在 body 原点下方 2cm
                 size="0.06 0.018 0.002"：长 12cm，宽 3.6cm，厚 4mm -->
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.05 0.001"
                  pos="0 0 -0.02" size="0.06 0.018 0.002" type="box" name="socket-1" rgba="0 0 1 1" />

            <!-- socket-2: 顶部薄板，pos z=+0.02 表示在 body 原点上 2cm，与底板对称 -->
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.05 0.001"
                  pos="0 0 0.02" size="0.06 0.018 0.002" type="box" name="socket-2" rgba="0 0 1 1" />

            <!-- socket-3: 右侧壁板，pos y=+0.02 表示在 body 原点左侧 2cm
                 注意这里 size 变成竖着的：厚 4mm，宽 3.6cm -->
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.05 0.001"
                  pos="0 0.02 0" size="0.06 0.002 0.018" type="box" name="socket-3" rgba="0 0 1 1" />

            <!-- socket-4: 左侧壁板，pos y=-0.02，与 socket-3 对称 -->
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.05 0.001"
                  pos="0 -0.02 0" size="0.06 0.002 0.018" type="box" name="socket-4" rgba="0 0 1 1" />

            <!-- pin: 中间的红色销钉，比 peg 细小（全长 8cm vs 12cm） -->
            <geom condim="4" solimp="2 1 0.01" solref="0.01 1" friction="1 0.005 0.0001"
                  pos="0 0 0" size="0.04 0.01 0.01" type="box" name="pin" rgba="1 0 0 1" />
        </body>

    </worldbody>
    <!-- ████████████████████  worldbody 结束  ████████████████████ -->


    <!-- ***********************************************************
         顶级子元素 (4)：<actuator>
         ─────────────────────────
         定义"驱动器"——给关节施加力/力矩，或者控制关节位置/速度的"马达"。

         可以把 actuator 理解为机器人的肌肉或电机：
         - 机器人上的每个电机 = XML 里的一个 actuator
         - actuator 通过 joint="关节名" 和对应的关节绑定
         - 你在代码里发送控制指令，actuator 把指令转化为力施加到关节上

         常见 actuator 类型及使用场景：
         ┌─────────────────┬────────────────────────────────────────┐
         │ 类型              │  作用及场景                            │
         ├─────────────────┼────────────────────────────────────────┤
         │ <motor>         │  通用力矩电机，直接施力，最灵活            │
         │ <position>      │  位置伺服 = PID 控制到目标位置             │
         │                 │  场景：想让关节转到指定角度                │
         │ <velocity>      │  速度伺服 = PID 控制到目标速度             │
         │                 │  场景：想让关节以指定速度转动               │
         │ <intvelocity>   │  积分速度控制                            │
         │ <general>       │  力+位置+速度混合控制，最强大也最复杂       │
         │ <cylinder>      │  模拟气动/液压缸                         │
         │ <adhesion>      │  模拟吸附/磁力（真空吸盘等）               │
         └─────────────────┴────────────────────────────────────────┘

         这里的场景是机械手抓取，所以用 <position> 控制爪子开合。
         ──────────────────────────────────────────────────────── -->
    <actuator>
        <!-- ── <position> 位置伺服 ──────────────────────────────
             这是一个"智能 PID 控制器"（MuJoCo 自动处理 PID 计算）。

             属性详解：
             joint        : 被驱动的关节名 → 对应 <joint name="...">
             kp           : 比例增益（比例=刚度，值越大控制越"硬"/精确）
             kv           : 微分增益（速度阻尼，默认自动计算）
             ctrllimited  : true=控制输入被裁剪到 ctrlrange 内
             ctrlrange    : 允许的控制范围 "min max"（单位：关节坐标）
             user         : 用户自定义标记（可用于分组/索引，不影响仿真）

             为什么左右手指的 ctrlrange 互为相反数？
             ─────────────────────────────────────
             因为 VX300S 爪子是对称开合的：
             - left_finger 正转 = 张开（关节值增大）
             - right_finger 反转 = 张开（关节值为负）
             所以要分别设正负范围，保证两个手指同步开合。
             0.021~0.057 对应爪子物理开合约 2.1cm~5.7cm。
             ──────────────────────────────────────────────────────── -->

        <!-- 左臂爪子 — 两个手指 -->
        <position ctrllimited="true" ctrlrange="0.021 0.057"   joint="vx300s_left/left_finger"  kp="200" user="1"/>
        <position ctrllimited="true" ctrlrange="-0.057 -0.021" joint="vx300s_left/right_finger" kp="200" user="1"/>

        <!-- 右臂爪子 — 两个手指 -->
        <position ctrllimited="true" ctrlrange="0.021 0.057"   joint="vx300s_right/left_finger"  kp="200" user="1"/>
        <position ctrllimited="true" ctrlrange="-0.057 -0.021" joint="vx300s_right/right_finger" kp="200" user="1"/>

    </actuator>


    <!-- ***********************************************************
         顶级子元素 (5)：<keyframe>
         ─────────────────────────
         定义"关键帧"——预存的一组系统状态快照。
         类似于动画的关键帧或游戏的存档点。

         子元素 <key> 的属性：
         qpos : 全部关节位置（按关节编号顺序排列）
         qvel : 全部关节速度（可选）
         ctrl : 全部控制信号（可选）
         mpos : 全部 mocap 体位置（可选）

         用途：
         - 训练 RL 时随机选一个关键帧作为 episode 的初始状态
         - 把仿真快速重置到已知的好状态进行调试
         - 录制机器人演示时标记起点和终点

         这个 keyframe 的 qpos 有 28 个数字，分解如下：
         ────────────────────────────────────────────────
         第 1~8:   左臂 8 个关节  → 0, -0.96, 1.16, 0, -0.3, 0, 0.024, -0.024
         第 9~16:  右臂 8 个关节  → 0, -0.96, 1.16, 0, -0.3, 0, 0.024, -0.024
         第 17~23: peg 的 free joint (pos + quat)
                   0.2 0.5 0.05  ← 位置 (x,y,z) 米
                   1 0 0 0       ← 姿态四元数 (w,x,y,z) → (1,0,0,0)=无旋转
         第 24~30: socket 的 free joint (pos + quat)
                   -0.2 0.5 0.05 ← 位置 (x,y,z) 米（注意在左边，与 peg 对称）
                   1 0 0 0       ← 姿态四元数 → 无旋转

         小贴士：
         - 四元数 (1, 0, 0, 0) 表示"没有旋转"（单位四元数）
         - free joint 的 qpos 是 7 个数：3 平移 + 4 四元数
         - 关节的排列顺序取决于它们在 XML 中（包括 include 的文件）
           被编译器解析的先后顺序
         ──────────────────────────────────────────────────────── -->
    <keyframe>
        <key qpos="0 -0.96 1.16 0 -0.3 0 0.024 -0.024  0 -0.96 1.16 0 -0.3 0 0.024 -0.024  0.2 0.5 0.05 1 0 0 0  -0.2 0.5 0.05 1 0 0 0"/>
    </keyframe>

</mujoco>

<!--
╔══════════════════════════════════════════════════════════════════╗
║                         学习要点总结                              ║
╠══════════════════════════════════════════════════════════════════╣
║                                                                  ║
║  1. MuJoCo XML 是树形结构，根元素是 <mujoco>                        ║
║  2. 物理世界在 <worldbody> 中定义，body 层层嵌套                    ║
║  3. 每个物理 body 需要三项基础：                                     ║
║     joint(连接方式) + inertial(质量属性) + geom(碰撞形状)           ║
║  4. <actuator> = 电机/马达，<sensor> = 传感器                      ║
║  5. <equality> 定义各种运动约束                                     ║
║  6. 参数值用空格分隔（不用逗号），如 "0.01 1"                         ║
║  7. 坐标系：右手系，X=前，Y=左，Z=上                                 ║
║  8. 单位制：弧度(rad) | 千克(kg) | 米(m) | 秒(s)                    ║
║  9. mocap body 是特殊的"手柄"体，不受物理力影响                       ║
║  10. 复杂形状 = 多个简单 geom 叠加                                  ║
║  11. <include> 用于模块化，把大模型拆成小文件                        ║
║  12. <keyframe> 定义初始状态，方便训练/调试                          ║
║                                                                  ║
║  日常调试技巧：                                                     ║
║  - 用 simulate viewer 打开 XML（终端输入: mujoco-simulate xxx.xml）║
║  - 在 viewer 中 Ctrl+右键拖动旋转视角，鼠标滚轮缩放                   ║
║  - 双击 body/geom 查看属性，按 Tab 显示接触力                        ║
║  - 终端错误信息会告诉你在第几行出问题                                  ║
║                                                                  ║
║  建议动手练习：                                                     ║
║  - 用 simulate 打开这个文件，看看效果                                ║
║  - 改一下 peg 或 socket 的 pos，看它移动到哪里                       ║
║  - 改一下某个 geom 的 rgba，看颜色变化                               ║
║  - 试着在 worldbody 里添加一个新 body（比如一个 sphere）              ║
║  - 阅读官方文档: https://mujoco.readthedocs.io                     ║
╚══════════════════════════════════════════════════════════════════╝
